    {
      "name": "03 — Driver Online & Nhận Đơn Đầu Tiên",
      "description": "Tài xế vào ca (Online) và tải đề xuất chuyến đầu tiên hiển thị trên màn hình Free-Pick.",
      "item": [
        {
          "name": "3.1 Driver Bật Online",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/drivers/me/online-status",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{driverToken}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"online\": true\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Driver Online thành công (200)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().online).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Tải Đề Xuất Đơn Đầu Tiên (Offer #1)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/drivers/me/offers/refresh",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{driverToken}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skippedAssignmentIds\": []\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Nhận Đơn đề xuất #1 hiển thị trên màn hình', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const offers = pm.response.json();",
                  "  pm.expect(offers).to.be.an('array').with.lengthOf(1);",
                  "  const offer1 = offers[0];",
                  "  pm.expect(offer1.assignmentId).to.be.a('string');",
                  "  pm.expect(offer1.status).to.equal('OFFERED');",
                  "  pm.expect(offer1.canRespond).to.be.true;",
                  "  pm.collectionVariables.set('offer1_assignmentId', offer1.assignmentId);",
                  "  pm.collectionVariables.set('offer1_orderId', offer1.orderId);",
                  "  if (pm.environment) {",
                  "    pm.environment.set('offer1_assignmentId', offer1.assignmentId);",
                  "    pm.environment.set('offer1_orderId', offer1.orderId);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 — Driver ấn nút Reload lần 1 (Bỏ qua Đơn #1)",
      "description": "Tài xế không muốn nhận đơn đang hiển thị (Offer #1) nên bấm nút Reload (↻). App gửi skippedAssignmentIds chứa Offer #1. Backend đánh dấu REJECTED cho Offer #1 và tìm đơn kế tiếp trong hàng chờ.",
      "item": [
        {
          "name": "4.1 Driver ấn Reload ↻ (Bỏ qua Offer #1 để lấy đơn mới)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/drivers/me/offers/refresh",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{driverToken}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skippedAssignmentIds\": [\"{{offer1_assignmentId}}\"]\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Reload lần 1 thành công: Trả về Đơn mới khác Đơn #1', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const offers = pm.response.json();",
                  "  pm.expect(offers).to.be.an('array').with.lengthOf(1);",
                  "  const offer2 = offers[0];",
                  "  const oldAssignmentId = pm.collectionVariables.get('offer1_assignmentId');",
                  "  const oldOrderId = pm.collectionVariables.get('offer1_orderId');",
                  "  pm.expect(offer2.assignmentId).to.not.equal(oldAssignmentId, 'AssignmentId mới phải khác AssignmentId cũ vừa bỏ qua');",
                  "  pm.expect(offer2.orderId).to.not.equal(oldOrderId, 'OrderId mới phải khác OrderId cũ vừa bỏ qua');",
                  "  pm.expect(offer2.status).to.equal('OFFERED');",
                  "  pm.collectionVariables.set('offer2_assignmentId', offer2.assignmentId);",
                  "  pm.collectionVariables.set('offer2_orderId', offer2.orderId);",
                  "  if (pm.environment) {",
                  "    pm.environment.set('offer2_assignmentId', offer2.assignmentId);",
                  "    pm.environment.set('offer2_orderId', offer2.orderId);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Xác minh Offer #1 đã chuyển sang trạng thái REJECTED",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/drivers/me/offers/{{offer1_assignmentId}}",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{driverToken}}", "type": "string" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Offer #1 đã được hệ thống ghi nhận là REJECTED', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.status).to.equal('REJECTED');",
                  "  pm.expect(data.canRespond).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 — Driver ấn nút Reload lần 2 (Bỏ qua Đơn #2)",
      "description": "Tài xế tiếp tục không muốn nhận đơn số 2 và ấn Reload (↻) lần nữa. Backend loại bỏ cả Offer #2 và cung cấp đơn số 3.",
      "item": [
        {
          "name": "5.1 Driver ấn Reload ↻ (Bỏ qua Offer #2 để lấy đơn mới)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/drivers/me/offers/refresh",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{driverToken}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skippedAssignmentIds\": [\"{{offer2_assignmentId}}\"]\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Reload lần 2 thành công: Trả về Đơn mới khác Đơn #1 và Đơn #2', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const offers = pm.response.json();",
                  "  pm.expect(offers).to.be.an('array').with.lengthOf(1);",
                  "  const offer3 = offers[0];",
                  "  const offer1Id = pm.collectionVariables.get('offer1_assignmentId');",
                  "  const offer2Id = pm.collectionVariables.get('offer2_assignmentId');",
                  "  pm.expect(offer3.assignmentId).to.not.equal(offer1Id);",
                  "  pm.expect(offer3.assignmentId).to.not.equal(offer2Id);",
                  "  pm.expect(offer3.status).to.equal('OFFERED');",
                  "  pm.collectionVariables.set('offer3_assignmentId', offer3.assignmentId);",
                  "  pm.collectionVariables.set('offer3_orderId', offer3.orderId);",
                  "  if (pm.environment) {",
                  "    pm.environment.set('offer3_assignmentId', offer3.assignmentId);",
                  "    pm.environment.set('offer3_orderId', offer3.orderId);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5.2 Xác minh Offer #2 đã chuyển sang trạng thái REJECTED",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/drivers/me/offers/{{offer2_assignmentId}}",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{driverToken}}", "type": "string" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Offer #2 đã được hệ thống ghi nhận là REJECTED', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.status).to.equal('REJECTED');",
                  "  pm.expect(data.canRespond).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 — Driver chấp nhận Đơn #3 & Xác nhận chuyến hiện tại",
      "description": "Sau khi reload liên tục đến đơn ưng ý (Đơn #3), Tài xế bấm nhận đơn (Accept) và bắt đầu chuyến giao hàng.",
      "item": [
        {
          "name": "6.1 Driver bấm Nhận Đơn #3 (Accept Offer)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/drivers/me/offers/{{offer3_assignmentId}}/accept",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{driverToken}}", "type": "string" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Nhận chuyến thành công (200 ACCEPTED)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.status).to.equal('ACCEPTED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6.2 Kiểm tra Chuyến Đi Hiện Tại của Driver",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/drivers/me/deliveries/current",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{driverToken}}", "type": "string" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Chuyến đi hiện tại đúng là Đơn #3 và trạng thái ASSIGNED', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const trip = pm.response.json();",
                  "  const expectedOrderId = pm.collectionVariables.get('offer3_orderId');",
                  "  pm.expect(trip.orderId).to.equal(expectedOrderId);",
                  "  pm.expect(trip.status).to.equal('ASSIGNED');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
