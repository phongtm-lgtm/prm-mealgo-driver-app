              "raw": "{\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"items\": [\n    {\n      \"menuItemId\": \"{{menuItemId}}\",\n      \"quantity\": 1,\n      \"note\": \"Đơn số 1 - Test reload\"\n    }\n  ],\n  \"recipient\": {\n    \"name\": \"Khách Đơn 1\",\n    \"phone\": \"0901234501\"\n  },\n  \"dropoff\": {\n    \"address\": \"Điểm giao 1 - Gần quán\",\n    \"latitude\": 21.038414,\n    \"longitude\": 105.547018\n  },\n  \"deliveryNote\": \"Giao cổng trước\",\n  \"paymentMethod\": \"COD\"\n}",
              "options": { "raw": { "language": "json" } }
            }
