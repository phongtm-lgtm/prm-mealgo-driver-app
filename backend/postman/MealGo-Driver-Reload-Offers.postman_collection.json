{
  "info": {
    "name": "MealGo — Driver Reload Free-Pick Offers Test",
    "description": "Kiểm thử tự động kịch bản Tài xế ấn nút Reload (↻) để tìm đơn mới khi không muốn nhận đơn đang hiển thị.\n\nKịch bản:\n1. Đăng nhập 3 bên (Khách hàng, Nhà hàng, Tài xế) & lấy Menu món ăn.\n2. Chuẩn bị sẵn 3 đơn hàng (Order 1, Order 2, Order 3) ở trạng thái PENDING_ASSIGNMENT.\n3. Driver bật Online và nhận đề xuất đơn đầu tiên (Offer 1).\n4. Driver ấn Reload lần 1: Gửi skippedAssignmentIds = [Offer 1] -> Hệ thống từ chối Offer 1 (REJECTED) và cấp Offer 2.\n5. Driver ấn Reload lần 2: Gửi skippedAssignmentIds = [Offer 2] -> Hệ thống từ chối Offer 2 (REJECTED) và cấp Offer 3.\n6. Driver đồng ý nhận Offer 3 -> Đơn chuyển thành ASSIGNED trong chuyến đi hiện tại.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "customerPhone", "value": "0900000003" },
    { "key": "merchantPhone", "value": "0900000002" },
    { "key": "driverPhone", "value": "0900000001" },
    { "key": "password", "value": "Mealgo123!" },
    { "key": "customerToken", "value": "" },
    { "key": "merchantToken", "value": "" },
    { "key": "driverToken", "value": "" },
    { "key": "restaurantId", "value": "" },
    { "key": "menuItemId", "value": "" },
    { "key": "orderId_1", "value": "" },
    { "key": "orderId_2", "value": "" },
    { "key": "orderId_3", "value": "" },
    { "key": "offer1_assignmentId", "value": "" },
    { "key": "offer1_orderId", "value": "" },
    { "key": "offer2_assignmentId", "value": "" },
    { "key": "offer2_orderId", "value": "" },
    { "key": "offer3_assignmentId", "value": "" },
    { "key": "offer3_orderId", "value": "" }
  ],
  "item": [
    {
      "name": "01 — Khởi tạo & Đăng nhập 3 bên",
      "item": [
        {
          "name": "1.1 Đăng nhập Customer",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{customerPhone}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Customer Login OK (200)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.accessToken).to.be.a('string');",
                  "  pm.collectionVariables.set('customerToken', data.accessToken);",
                  "  if (pm.environment) pm.environment.set('customerToken', data.accessToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Đăng nhập Merchant (Quán ăn)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{merchantPhone}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Merchant Login OK (200)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.accessToken).to.be.a('string');",
                  "  pm.collectionVariables.set('merchantToken', data.accessToken);",
                  "  if (pm.environment) pm.environment.set('merchantToken', data.accessToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Đăng nhập Driver (Tài xế)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{driverPhone}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Driver Login OK (200)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.accessToken).to.be.a('string');",
                  "  pm.collectionVariables.set('driverToken', data.accessToken);",
                  "  if (pm.environment) pm.environment.set('driverToken', data.accessToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Lấy thông tin Menu & Quán ăn",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/customers/menu?restaurantName=MealGo%20Demo%20Restaurant",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lấy thông tin Quán & Món thành công', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const shops = pm.response.json();",
                  "  const shop = shops.find(s => s.restaurantName === 'MealGo Demo Restaurant') || shops[0];",
                  "  pm.expect(shop).to.exist;",
                  "  pm.collectionVariables.set('restaurantId', shop.restaurantId);",
                  "  const dish = shop.items.find(i => i.available) || shop.items[0];",
                  "  pm.collectionVariables.set('menuItemId', dish.menuItemId);",
                  "  if (pm.environment) {",
                  "    pm.environment.set('restaurantId', shop.restaurantId);",
                  "    pm.environment.set('menuItemId', dish.menuItemId);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 — Chuẩn bị sẵn 3 đơn hàng Pending trong hàng chờ",
      "description": "Tạo 3 đơn hàng từ Khách và để Nhà hàng nhận đơn (PREPARING) để hệ thống đưa vào hàng chờ Delivery PENDING_ASSIGNMENT.",
